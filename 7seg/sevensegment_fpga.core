CAPI=2:
# SPDX-License-Identifier: MIT

name: bloeckchengrafik:ip:7seg_synth:0.1.0
description: "7 Segment Display Synth target"

filesets:
  board:
    files:
      - rtl/board/boolean_top.sv
    file_type: systemVerilogSource
    depend:
      - bloeckchengrafik:ip:7seg:0.1.0
  constraints:
    files:
      - ../boards/boolean.xdc
    file_type: xdc
  sim:
    files:
      - rtl/tb/7seg_tb.sv
    file_type: systemVerilogSource
    depend:
      - bloeckchengrafik:ip:7seg:0.1.0

targets:
  default: &default
    filesets:
      - board
      - constraints
    toplevel: boolean_top
    description: Synthesize the design for the boolean board
    flow: vivado
    flow_options:
      part: xc7s50csga324-2

  sim:
    filesets:
      - sim
    toplevel: sevseg_4mul_tb
    description: Simulate the 7-segment display peripheral
    default_tool: icarus
    tools:
      icarus:
        iverilog_options:
          - -g2012
